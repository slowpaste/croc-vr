extends SceneTree
const Save=preload("res://source_save_session.gd")
func _initialize() -> void:
	var state := Save.initialize([{"path":"existing"}],"new")
	state=Save.advance(state,0,0x800000)
	assert(state.overwrite and state.navigation.selected==1 and state.pending_path=="")
	state=Save.advance(state,0,0x800000);assert(not state.overwrite and state.pending_path=="" and not state.exit_requested)
	state=Save.advance(state,0,0x800000);state=Save.advance(state,0,0x10000)
	assert(state.navigation.selected==0)
	state=Save.advance(state,0,0x800000);assert(state.pending_path=="existing")
	assert(Save.advance(state,0,0x100000).pending_path=="existing")
	state=Save.initialize([{"path":"existing"}],"new")
	state=Save.advance(state,0,0x80000);state=Save.advance(state,0,0x800000)
	assert(state.slot==1 and state.pending_path=="new" and not state.overwrite)
	state=Save.initialize([],"new");assert(Save.advance(state,0,0x800000).pending_path=="new")
	state=Save.initialize([{"path":"existing"}],"new");state=Save.advance(state,0,0x800000)
	assert(not Save.advance(state,0,0x100000).overwrite)
	assert(Save.advance(Save.initialize([],"new"),0,0x100000).exit_requested)
	print("PASS: Save existing-slot confirmation defaults to cancel, explicit approval requests overwrite, new slot requests and cancel")
	quit(0)
