extends SceneTree
func _initialize() -> void:
	var fade = preload("res://source_transition_fade.gd")
	var state: Dictionary = fade.start(3)
	assert(state.counter == 256 and state.level == 255)
	assert(fade.advance(state,1).counter == 256)
	for tick in range(8): state = fade.advance(state,0)
	assert(state.counter == 0 and state.active and not state.ready)
	state = fade.advance(state,0)
	assert(state.level == 0 and state.ready and not state.active)
	state = fade.start(1)
	assert(state.counter == 288 and state.level == 255)
	state = fade.advance(state,0)
	assert(state.counter == 256 and state.level == 255)
	for tick in range(8): state = fade.advance(state,0)
	assert(state.counter == 0 and state.active and not state.ready)
	state = fade.advance(state,0)
	assert(state.level == 0 and state.ready and not state.active)
	print("PASS: native incoming-white256/nine-tick and SAD incoming-black288/ten-tick fade boundaries")
	quit(0)
